# ─────────────────────────────────────────────────────────
# SafePath AI — Backend Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────
# SQLite (prototype):
DATABASE_URL=sqlite+aiosqlite:///./safepath.db

# PostgreSQL + PostGIS (production — uncomment when ready):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/safepath

# ── Firebase ──────────────────────────────────────────────
# Your Firebase project ID (found in Project Settings)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Absolute path to the Firebase Admin SDK service-account JSON key file.
# Download from: Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT_JSON=./firebase-service-account.json

# ── Security ──────────────────────────────────────────────
# A long random secret used for internal signing (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slashes)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-production-domain.com

# ── Geospatial Parameters ─────────────────────────────────
# Radius (metres) within which two reports are considered the same hazard (crowdsourcing)
CROWDSOURCE_RADIUS_METRES=15

# Minimum number of unique users confirming a hazard before it is "verified"
CROWDSOURCE_MIN_REPORTS=2

# Confidence threshold below which a detected hazard is silently discarded
CONFIDENCE_THRESHOLD=0.35

# WebSocket alert broadcast radius (metres) — users within this radius receive the push
ALERT_BROADCAST_RADIUS_METRES=500

# ── AI / Model Paths (Week 5+ — leave empty for mock mode) ─
# Absolute or relative path to the YOLOv8 Nano ONNX model file
VISION_MODEL_PATH=

# Absolute or relative path to the CNN-LSTM TFLite sensor model file
SENSOR_MODEL_PATH=

# ── App Settings ──────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
